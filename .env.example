# ── Free Website Check (api/audit.js + api/unlock.js) ─────────────────────
# Set these in Vercel: Project > Settings > Environment Variables.
# For local testing, copy this file to .env.local (gitignored) and run: npm run dev

# Required. Any long random string. Encrypts the full report until an email is given.
AUDIT_SECRET=

# Required to receive leads by email. Free account at https://resend.com
RESEND_API_KEY=
# Where lead alerts go
LEAD_NOTIFY_EMAIL=hello@evergreendigitalco.com
# Sender. Must be on a domain verified in Resend. Until then leave blank:
# Resend's test sender only delivers to the email that owns the Resend account.
AUDIT_FROM_EMAIL="Evergreen Site Check <audit@evergreendigitalco.com>"
# "true" = also email the prospect a copy of their report (needs verified domain)
AUDIT_EMAIL_LEAD=false

# Recommended. Free key from Google Cloud (PageSpeed Insights API).
# Without it the speed check often fails and is left out of the score.
PAGESPEED_API_KEY=

# Optional. Places API (New) key. Enables the Google Business Profile + reviews
# check and the phone-number match. Without it that check is "not scored".
GOOGLE_PLACES_API_KEY=
